{"nodes":[{"id":"group_client","type":"group","x":-620,"y":-200,"width":360,"height":360,"label":"客户端","color":"5"},{"id":"node_web","type":"text","x":-590,"y":-150,"width":300,"height":170,"text":"# web/index.html\n\n- /api/run 流式 NDJSON\n- 文件上传与预览\n- HITL 审批卡片\n- 沙箱切换"},{"id":"node_cli","type":"text","x":-590,"y":40,"width":300,"height":120,"text":"# main.py\n\n- Rich CLI 交互\n- 直接调用 ManusAgent"},{"id":"group_server","type":"group","x":-200,"y":-200,"width":360,"height":360,"label":"服务层 (FastAPI)","color":"4"},{"id":"node_server","type":"text","x":-170,"y":-150,"width":300,"height":230,"text":"# server.py\n\n- POST /api/run\n- POST /api/upload\n- GET /api/skills\n- 静态资源与下载"},{"id":"group_agent","type":"group","x":260,"y":-200,"width":420,"height":420,"label":"智能体核心","color":"6"},{"id":"node_agent","type":"text","x":290,"y":-150,"width":360,"height":220,"text":"# agent.py\n\n- DeepAgents + LangGraph\n- MemorySaver\n- HITL Middleware\n- 沙箱实例管理"},{"id":"node_subagents","type":"text","x":290,"y":90,"width":360,"height":120,"text":"# Subagents\n\n- CodeWriter\n- CodeReviewer\n- 技能注入"},{"id":"group_tools","type":"group","x":740,"y":-200,"width":360,"height":420,"label":"工具层","color":"3"},{"id":"node_tools","type":"text","x":770,"y":-150,"width":300,"height":260,"text":"# tools.py\n\n- run_code / run_shell_command\n- list/read/write_file\n- visualize_file / get_public_url\n- upload/download"},{"id":"group_sandbox","type":"group","x":1140,"y":-200,"width":420,"height":420,"label":"沙箱适配层","color":"2"},{"id":"node_interface","type":"text","x":1170,"y":-150,"width":360,"height":120,"text":"# sandbox_interface.py\n\n- BaseSandbox\n- CommandResult / FileInfo"},{"id":"node_e2b","type":"text","x":1170,"y":0,"width":360,"height":90,"text":"# sandbox_adapter_e2b.py\n\n- E2B AsyncSandbox"},{"id":"node_open","type":"text","x":1170,"y":110,"width":360,"height":90,"text":"# sandbox_adapter_opensandbox.py\n\n- OpenSandbox SDK"},{"id":"group_external","type":"group","x":1580,"y":-200,"wi