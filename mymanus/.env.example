# LLM API Configuration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
MODEL_ID=deepseek-ai/DeepSeek-V3

# Sandbox Configuration
# Choose sandbox provider: "e2b" or "opensandbox"
SANDBOX_PROVIDER=opensandbox

# E2B Configuration (if using e2b provider)
E2B_API_KEY=

# OpenSandbox Configuration (if using opensandbox provider)
# Local OpenSandbox server endpoint
OPEN_SANDBOX_DOMAIN=127.0.0.1:8082
# API key (leave empty for local development)
OPEN_SANDBOX_API_KEY=