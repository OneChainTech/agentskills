DEEPSEEK_API_KEY=sk-cspikfuwshxizamcgmzxbnkrnxnevaqrxsbsrizrmvuhqpko
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
# 基础大模型用于提取和检索 (GLM-4.7)
BASE_MODEL_ID=Qwen/Qwen3-VL-32B-Instruct
# OCR 模型用于多模��识别 (Qwen2-VL - DeepSeek-OCR has issues on SiliconFlow)
OCR_MODEL_ID=Qwen/Qwen3-VL-32B-Instruct
# Embedding 模型用于向量检索，使用硅基流动的在线模型
EMBEDDING_MODEL_ID=BAAI/bge-m3

# ===== 性能优化配置 =====
# OCR 优化
OCR_MAX_WORKERS=8
OCR_HTTP_TIMEOUT_SEC=120

# 检索优化 - 减少 chunk 数量以加速索引构建
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_CHUNKS_PER_PAGE=8
MAX_TOTAL_CHUNKS=60

# Query 优化 - 平衡准确度和速度
ENABLE_QUERY_REWRITE=1
ENABLE_MULTI_QUERY=0
ENABLE_RERANK=1
RERANK_THRESHOLD=5
VECTOR_K=8
BM25_K=8
INITIAL_CANDIDATE_LIMIT=20
FINAL_CONTEXT_DOCS=3

# 超时优化
ANSWER_TIMEOUT_SEC=60
